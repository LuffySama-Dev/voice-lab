{
  "name": "voice-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:setup": "python3 -B tests/setup_voice_test.py",
    "test:ui": "playwright test",
    "demo:background": "node scripts/demo.mjs",
    "setup:voice": "python3 scripts/setup-voice.py",
    "voice:background": "node --env-file-if-exists=.env.voice scripts/demo.mjs --codex-voice",
    "codex:background": "node scripts/demo.mjs --codex",
    "mic:background": "node scripts/demo.mjs --local-mic",
    "build:native": "sh scripts/build-native.sh",
    "test:native": "node scripts/test-native.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
