# Enter privately in a local editor. Never paste credentials into chat.
# Live mode needs these three values and completed YAP setup below.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Use an existing, authorized Professional Voice Clone ID. No voice creation occurs.
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
OPENAI_SERVICE_TIER=fast
PORT=4317

# Selected local transcription backend. Optional cloud alternative: openai
ASR_PROVIDER=yap
YAP_PATH=/opt/homebrew/bin/yap
YAP_LOCALE=en-US
# Set to 1 yourself after reviewing native permission/asset setup in README.
# First YAP dictation may automatically download Apple speech-language assets.
YAP_READY=0

# Transcription-only test switch (no cloud credentials required).
LOCAL_MIC_ENABLED=0
# Local mic draft captions: build:native first. 0 uses unmodified YAP final segments.
LOCAL_PARTIALS_ENABLED=1
# Paid integrations are OFF for this checkpoint. Enable explicitly only when ready.
PAID_SERVICES_ENABLED=0

# Codex subscription text mode: explicit opt-in. Uses existing ChatGPT Codex sign-in.
# Text goes to OpenAI; no direct API key or ElevenLabs needed.
# Demo tool restrictions are mitigations, not proven isolation.
CODEX_AI_ENABLED=0
# Conversation runtime only; does not change the coding assistant preference.
CODEX_MODEL=gpt-6-astra
CODEX_REASONING_EFFORT=low

# Optional Codex replies → Eleven v4 Turbo. Separate from direct OpenAI paid APIs.
# Enable only after choosing an authorized voice and approving paid Eleven usage.
# Prefer npm run setup:voice for hidden key entry into ignored .env.voice.
ELEVEN_TTS_ENABLED=0

# Optional OpenRouter conversation. Separate opt-in; remains disabled initially.
# Use setup:openrouter privately after account/credits/budget approval.
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=0
